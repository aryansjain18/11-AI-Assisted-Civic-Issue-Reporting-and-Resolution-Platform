# CivicFix — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local with real credentials.

# --- Supabase (required for M2+) ---
# Use your Supabase project URL and public/publishable key only.
# NEVER put a secret key or service-role key in frontend VITE_ variables.
VITE_SUPABASE_URL=https://dqeutphlzcaekxdjxvdd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_POhRshjEFpMCQOXP0ts4iw_YPzN3n8m

# --- Google Maps JavaScript API (optional) ---
# Browser API key restricted to HTTP referrer + Maps JS API only.
# Core reporting works without this key (text input fallback is used).
# VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# --- Gemini API (DO NOT use VITE_ prefix — keep this server-side only) ---
# Set GEMINI_API_KEY as a Supabase Edge Function secret, NOT here.
# See docs/03_TECH_STACK.md for details.
